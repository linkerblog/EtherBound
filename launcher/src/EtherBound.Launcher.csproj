<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EtherBound</AssemblyName>
    <RootNamespace>EtherBound.Launcher</RootNamespace>
    <!-- The launcher module version: it moves together with docs/utils/VERSION.md. -->
    <Version>0.0.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Publishing into the repo root must leave nothing there but EtherBound.exe. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtherBound.Launcher.Tests" />
  </ItemGroup>

  <!-- The exe belongs in the checkout root, where it is double-clicked. It is copied there after
       publishing rather than published there: an output folder above the project would exclude the
       project's own sources from the build. -->
  <Target Name="CopyToCheckoutRoot" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(MSBuildProjectDirectory)\..\.." />
  </Target>

</Project>
